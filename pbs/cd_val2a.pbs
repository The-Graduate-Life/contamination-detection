#!/bin/bash
# ASC job: second-round validation on NON-HOST pools — competitive panel (PANEL=nonhost) and GRCh38
# human validation, both runs. (Split from cd_val2 so it can use the medium queue.)
#PBS -N cd_val2a
#PBS -q medium
#PBS -l select=1:ncpus=16:mem=16gb
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -r n
source /scratch/aubfxp001/contamination_detection/pbs/asc_env.sh
mkdir -p logs/13_nonhost logs/14_human
rc=0
for run in SRR39022911 SRR29854842; do
    PANEL=nonhost bash scripts/06_validate_candidates.sh $run nonhost > logs/13_nonhost/asc_$run.log 2>&1 || { echo "panel $run failed"; rc=1; }
    bash scripts/14_human.sh $run > logs/14_human/asc_$run.log 2>&1 || { echo "human $run failed"; rc=1; }
done
echo "exit $rc"
exit $rc
